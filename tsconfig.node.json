{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["vite.config.ts", "unocss.config.ts"]
}
