{
  "name": "tellory",
  "version": "0.0.1",
  "description": "The Tellory interactive story engine shared SDK: story source parsing, serialization and rendering.",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist/*",
    "README.md"
  ],
  "keywords": [
    "sdk",
    "interactive-fiction",
    "story-engine"
  ],
  "bugs": {
    "url": "https://github.com/imlinhanchao/tellory/issues"
  },
  "homepage": "https://tellory.adventext.fun/",
  "author": {
    "name": "Hancel.Lin",
    "email": "imlinhanchao@foxmail.com",
    "url": "https://github.com/imlinhanchao"
  },
  "license": "MIT",
  "engines": {
    "node": ">=12.0"
  },
  "scripts": {
    "format": "prettier --write src/",
    "prebuild": "npm run format",
    "prepare": "npm run build",
    "build": "tsdown src/index.ts",
    "dev": "tsdown src/index.ts --watch",
    "docs:build": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "devDependencies": {
    "tsdown": "^0.18.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.1.6"
  },
  "release": {
    "branches": [
      "master"
    ]
  }
}
